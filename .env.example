# Copy this file to .env and fill in your values. Never commit .env to Git.
DATABASE_URL=mysql+pymysql://lekka:choose-a-strong-password@localhost/lekka_db?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-string
TZ=Asia/Kolkata
FLASK_APP=app:create_app

# Optional
# LEKKA_DUE_SOON_DAYS=7
# LEKKA_HORIZON_MONTHS=12
# For demos only: pretend today is this date
# LEKKA_FIXED_TODAY=2026-11-25
# To run the tests on MariaDB instead of SQLite (use an empty database)
# LEKKA_TEST_DATABASE_URL=mysql+pymysql://lekka:choose-a-strong-password@localhost/lekka_test?charset=utf8mb4
